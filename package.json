{
  "name": "fertility-grove",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome check --write .",
    "analyze": "next analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^7",
    "lucide-react": "^1.66",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6",
    "@playwright/test": "^1.64",
    "@tailwindcss/postcss": "^4.3",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19.3",
    "@types/react-dom": "^19.3",
    "@vitest/coverage-v8": "^5",
    "axe-core": "^4",
    "fast-check": "^3",
    "jsdom": "^29",
    "tailwindcss": "^4.3",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5"
  },
  "resolutions": {
    "postcss": "^8.5.28",
    "source-map-js": "^1.2.2"
  }
}
